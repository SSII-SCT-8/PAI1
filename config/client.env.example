# Configuración del cliente

# Servidor
SERVER_HOST=127.0.0.1
SERVER_PORT=9999
CONNECT_TIMEOUT=60.0
MESSAGE_TIMEOUT=60.0

# Seguridad - CRÍTICO: Debe ser la misma que el servidor
# La MASTER_KEY debe ser una clave de al menos 256 bits generada de forma segura
MASTER_KEY=CHANGE_THIS_IN_PRODUCTION_USE_256_BIT_KEY_MINIMUM

# Logs
LOG_LEVEL=INFO
