# Configuración del servidor
# IMPORTANTE: En producción, usar variables de entorno seguras

# Red
SERVER_HOST=127.0.0.1
SERVER_PORT=9999
CLIENT_MESSAGE_TIMEOUT=60.0

# Seguridad - CRÍTICO: Cambiar en producción
# La MASTER_KEY debe ser una clave de al menos 256 bits generada de forma segura
# Ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_KEY=CHANGE_THIS_IN_PRODUCTION_USE_256_BIT_KEY_MINIMUM

# Logs
LOG_LEVEL=INFO
